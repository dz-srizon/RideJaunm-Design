    "hard_refusals": [
      "single-tap SOS",
      "swipe-to-activate SOS",
      "decorative red",
      "humour or emoji on an armed SOS surface",
      "map on the Emergency Console",
      "theming SOS away in Blackout",
      "dropping the Signal Matrix",
      "removing the 10s cancel window"
